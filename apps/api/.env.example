PORT=4000
WEB_ORIGIN=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,https://aington.vercel.app
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: enables generated deep-report text. Core MVP APIs work without it.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3-flash-preview
# Optional for local service-account auth. Do not commit the JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=./vertex-service-account.json
# Optional for serverless deploys where a credential file path is unavailable.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Legacy fallback only. Vertex AI is used when GOOGLE_CLOUD_PROJECT is set.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview
