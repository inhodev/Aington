PORT=4000
WEB_ORIGIN=http://localhost:3000
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.0-flash-001
